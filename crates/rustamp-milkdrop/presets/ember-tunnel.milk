[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=0
fRating=3
fDecay=0.965
fGammaAdj=1.6
fVideoEchoZoom=1.0
fVideoEchoAlpha=0.0
nVideoEchoOrientation=0
nWaveMode=2
bAdditiveWaves=1
bWaveThick=1
bMaximizeWaveColor=0
fWaveAlpha=0.9
fWaveScale=1.4
fWarpAmount=0.6
fWarpScale=1.2
fWarpAnimSpeed=1.0
zoom=1.03
rot=0.0
cx=0.5
cy=0.5
wave_r=1.0
wave_g=0.45
wave_b=0.1
wave_x=0.5
wave_y=0.5
per_frame_1=rot = 0.02*sin(time*0.37);
per_frame_2=zoom = 1.02 + 0.03*bass_att;
per_frame_3=wave_r = 0.8 + 0.2*sin(time*1.3);
per_frame_4=wave_g = 0.35 + 0.25*treb_att;
per_frame_5=wave_b = 0.08 + 0.1*mid_att;
per_pixel_1=zoom = zoom + 0.04*sin(rad*9 - time*1.7)*(0.3 + bass_att);
per_pixel_2=rot = rot + 0.03*rad*sin(time*0.6);
