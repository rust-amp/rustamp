wave_g=0.8
wave_b=0.7
wave_x=0.5
wave_y=0.5
ob_size=0.01
ob_r=0.55
ob_g=0.25
ob_b=0.1
ob_a=0.35
per_frame_init_1=phase = 0;
per_frame_1=phase = phase + 0.01 + 0.04*mid_att;
per_frame_2=wave_r = 0.5 + 0.5*sin(phase);
per_frame_3=wave_g = 0.5 + 0.5*sin(phase*1.31 + 2);
per_frame_4=wave_b = 0.5 + 0.5*sin(phase*0.77 + 4);
per_frame_5=q1 = bass_att;
per_pixel_1=dx = 0.006*sin(ang*3 + time)*q1;
per_pixel_2=dy = 0.006*cos(ang*3 - time)*q1;
