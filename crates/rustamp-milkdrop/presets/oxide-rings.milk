shapecode_0_g=0.4
shapecode_0_b=0.1
shapecode_0_a=0.5
shapecode_0_r2=0.1
shapecode_0_g2=0.2
shapecode_0_b2=0.4
shapecode_0_a2=0
shapecode_0_border_r=1
shapecode_0_border_g=0.7
shapecode_0_border_b=0.3
shapecode_0_border_a=0.8
shape_0_per_frame1=rad = 0.08 + 0.12*bass_att;
shape_0_per_frame2=ang = time*0.4;
