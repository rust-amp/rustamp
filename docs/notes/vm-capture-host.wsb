<Configuration>
  <!--
    Rustamp dirty-room capture inside Windows Sandbox.
    See docs/notes/VM-capture-host.md for why and how.

    Every boot is a pristine, identical Windows: that is the strongest baseline
    provenance we can get ("every capture started from a freshly booted
    sandbox"). There are no mid-run snapshots - each baseline is a fresh boot
    plus the setup actions the bootstrap performs.

    Launch from the host (after the feature is enabled and the machine has been
    restarted):  WindowsSandbox.exe D:\code\Rustamp\docs\notes\vm-capture-host.wsb
  -->
  <MappedFolders>
    <!-- Writable: the harness writes captures and manifests back here. -->
    <MappedFolder>
      <HostFolder>D:\code\rustamp-research</HostFolder>
      <SandboxFolder>C:\rustamp-research</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <!-- Read-only: the already-extracted reference copy, never modified. -->
    <MappedFolder>
      <HostFolder>D:\code\rustamp-sandbox\winamp295</HostFolder>
      <SandboxFolder>C:\winamp295</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>

  <!--
    Network is ON because the owner authorised installing tools inside the
    sandbox (PowerShell 7, whatever the bootstrap needs). The sandbox is wiped
    on close, so an install is per boot: the bootstrap must script it or fall
    back to the built-in Windows PowerShell 5.1, which is what the probes ran on.
  -->
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>
  <!-- Software rendering on purpose: one less source of pixel variation. -->
  <vGPU>Disable</vGPU>
  <ClipboardRedirection>Disable</ClipboardRedirection>

  <!-- Runs once at logon, in the sandbox's own interactive session. -->
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\rustamp-research\tools\vm-capture\sandbox-bootstrap.ps1</Command>
  </LogonCommand>
</Configuration>
